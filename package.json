{
  "name": "neurolab-v2-playwright-audit",
  "version": "1.1.0",
  "private": true,
  "description": "Auditoria automatizada do NeuroLab V2 com mecanismo vertical, cobertura contextual e testes de orientação retrato.",
  "scripts": {
    "test": "npm run check:metaforas && playwright test",
    "check:metaforas": "node tools/verifica-metaforas.js",
    "test:smoke": "playwright test --grep @smoke",
    "test:coverage": "playwright test --grep @coverage --project=mobile-chromium",
    "test:visual": "playwright test --grep @visual --project=mobile-chromium",
    "report": "playwright show-report"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1"
  }
}
