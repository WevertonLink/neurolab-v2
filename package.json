{
  "name": "neurolab-v2-playwright-audit",
  "version": "1.0.0",
  "private": true,
  "description": "Auditoria automatizada visual, funcional e estrutural do NeuroLab V2.",
  "scripts": {
    "test": "playwright test",
    "test:smoke": "playwright test --grep @smoke",
    "test:coverage": "playwright test --grep @coverage --project=mobile-chromium",
    "test:visual": "playwright test --grep @visual --project=mobile-chromium",
    "report": "playwright show-report"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1"
  }
}
